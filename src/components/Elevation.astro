---
/**
 * "Why you can see them": a profile along the line of sight, west from the house to the
 * plateau, with approximate heights above sea level. The building is drawn floor by floor with
 * the eleventh lit, the rooftops of Al Haram in front of it, and the sight line from the
 * balcony to the apex of Khufu. Vertical scale is exaggerated (x2.5), and says so.
 */
import { useT, digits, type Lang } from '../i18n';
import { SITE, PYRAMIDS } from '../data/site';
import { distanceKm } from '../lib/geo';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { t } = useT(lang);
const W = 960, H = 250, GROUND = 198, KM = 230, M = 0.58; // px per km, px per metre
const HX = 640; // the house
const x = (kmWest: number) => HX - kmWest * KM;
const y = (mASL: number) => GROUND - mASL * M;
// approximate elevations, metres above sea level
const E = { street: 25, roofs: 45, floor11: 58, roof: 64, sphinx: 35, khufuBase: 60, khafreBase: 70, menkaureBase: 68, nile: 17 };
const kh = PYRAMIDS.map((p) => ({ ...p, km: distanceKm(SITE.geo, p.at) }));
const khufu = kh.find((p) => p.id === 'khufu')!, khafre = kh.find((p) => p.id === 'khafre')!, menk = kh.find((p) => p.id === 'menkaure')!;
const pyr = (p: typeof khufu, base: number, halfBaseM: number) => `M${x(p.km) - halfBaseM / 1000 * KM} ${y(base)} L${x(p.km)} ${y(base + p.height)} L${x(p.km) + halfBaseM / 1000 * KM} ${y(base)} Z`;
const floors = 11, floorH = (E.floor11 - E.street) / (floors - 1);
const sight = { x1: HX, y1: y(E.floor11 + 1.5), x2: x(khufu.km), y2: y(E.khufuBase + khufu.height) };
const d = (n: number) => digits(String(Math.round(n)), lang);
const km = (n: number) => digits(n.toFixed(1), lang);
---
<figure class="elev rv" dir="ltr" aria-label={t('elev.title')}>
  <div class="elev-scroll"><svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={t('elev.title')}>
    <defs><linearGradient id="elev-ground" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--gold)" stop-opacity=".18" /><stop offset="1" stop-color="var(--gold)" stop-opacity=".02" /></linearGradient></defs>
    <!-- ground profile: plateau on the left stepping down to the street, then the Nile valley off to the right -->
    <path class="ground" d={`M0 ${y(72)} H${x(2.6)} C ${x(2.3)} ${y(70)}, ${x(2.1)} ${y(70)} ${x(1.95)} ${y(E.khufuBase)} L${x(1.35)} ${y(E.sphinx)} C ${x(1.1)} ${y(28)}, ${x(0.6)} ${y(E.street)} ${HX} ${y(E.street)} H${W - 70} C ${W - 60} ${y(E.street)}, ${W - 50} ${y(E.nile)} ${W - 40} ${y(E.nile)} H${W} V${H} H0 Z`} fill="url(#elev-ground)" />
    <path class="ground-line draw" d={`M0 ${y(72)} H${x(2.6)} C ${x(2.3)} ${y(70)}, ${x(2.1)} ${y(70)} ${x(1.95)} ${y(E.khufuBase)} L${x(1.35)} ${y(E.sphinx)} C ${x(1.1)} ${y(28)}, ${x(0.6)} ${y(E.street)} ${HX} ${y(E.street)} H${W - 70} C ${W - 60} ${y(E.street)}, ${W - 50} ${y(E.nile)} ${W - 40} ${y(E.nile)} H${W}`} />
    <path class="nile" d={`M${W - 40} ${y(E.nile) + 4} q 6 -3 12 0 t 12 0 t 12 0`} />
    <!-- the pyramids, Menkaure behind, Khafre, Khufu -->
    <path class="pyr" d={pyr(menk, E.menkaureBase, 52)} />
    <path class="pyr" d={pyr(khafre, E.khafreBase, 108)} />
    <path class="pyr pyr-khufu" d={pyr(khufu, E.khufuBase, 115)} />
    <path class="edge" d={`M${x(khufu.km)} ${y(E.khufuBase + khufu.height)} L${x(khufu.km) + 18} ${y(E.khufuBase)}`} />
    <!-- the Sphinx, a small block at the foot -->
    <rect class="sphinx" x={x(1.42)} y={y(E.sphinx + 20)} width="10" height={20 * M} />
    <!-- rooftops of Al Haram between the house and the plateau -->
    <g class="roofs">
      {Array.from({ length: 9 }, (_, i) => { const kx = 0.12 + i * 0.13, h = 32 + ((i * 7) % 4) * 5; return <rect x={x(kx) - 9} y={y(E.street + h)} width="18" height={h * M} />; })}
    </g>
    <!-- the house: eleven floors and the roof terrace -->
    <g class="house">
      <rect x={HX - 14} y={y(E.roof)} width="28" height={(E.roof - E.street) * M} />
      {Array.from({ length: floors }, (_, i) => <line x1={HX - 14} x2={HX + 14} y1={y(E.street + i * floorH)} y2={y(E.street + i * floorH)} />)}
      <rect class="floor11" x={HX - 14} y={y(E.floor11 + floorH * 0.9)} width="28" height={floorH * 0.9 * M} />
      <path class="terrace" d={`M${HX - 18} ${y(E.roof)} h36`} />
      <text class="lbl-floor" x={HX + 22} y={y(E.floor11) + 4}>{t('elev.floor', { n: digits('11', lang) })}</text>
      <text class="lbl-small" x={HX + 22} y={y(E.floor11) + 18}>{t('elev.asl', { m: d(E.floor11) })}</text>
    </g>
    <!-- the sight line -->
    <line class="sight draw" x1={sight.x1} y1={sight.y1} x2={sight.x2} y2={sight.y2} />
    <path class="sight-wedge" d={`M${sight.x1} ${sight.y1} L${sight.x2} ${sight.y2} L${x(menk.km)} ${y(E.menkaureBase + menk.height)} Z`} />
    <!-- labels -->
    <text class="lbl" x={x(khufu.km)} y={y(E.khufuBase + khufu.height) - 10} text-anchor="middle">{khufu.name[lang]} · {t('elev.apex', { m: d(E.khufuBase + khufu.height) })}</text>
    <text class="lbl-small" x={x(khufu.km) + 10} y={y(E.khufuBase) + 16} text-anchor="middle">{t('elev.base', { m: d(E.khufuBase) })}</text>
    <text class="lbl-small" x={x(1.42) + 5} y={y(E.sphinx) + 16} text-anchor="middle">{t('elev.sphinx')}</text>
    <text class="lbl-small" x={x(1.0)} y={y(E.street + 52) - 6} text-anchor="middle">{t('elev.roofs', { m: d(E.roofs) })}</text>
    <text class="lbl-small" x={W - 12} y={y(E.nile) + 22} text-anchor="end">{t('elev.nile')}</text>
    <!-- distance scale along the ground -->
    <g class="scale">
      {[0, 0.5, 1, 1.5, 2].map((k) => <g transform={`translate(${x(k)} ${GROUND + 18})`}><line y1="-6" y2="0" /><text y="14" text-anchor="middle">{k === 0 ? t('elev.here') : `${km(k)} km`}</text></g>)}
      <line x1={x(2)} x2={HX} y1={GROUND + 18} y2={GROUND + 18} />
    </g>
    <text class="lbl-note" x={12} y={H - 8} text-anchor="start">{t('elev.note')}</text>
  </svg></div>
  <figcaption>{t('elev.caption', { floor: d(E.floor11), base: d(E.khufuBase) })}</figcaption>
</figure>
<script>
  document.querySelectorAll<HTMLElement>('.elev').forEach((el) => { const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { el.classList.add('go'); io.disconnect(); } }), { threshold: 0.3 }); io.observe(el); });
</script>
<style>
  .elev { margin: 0; background: var(--paper); border: 1px solid var(--line); position: relative; }
  .elev-scroll { overflow-x: auto; scrollbar-width: thin; }
  .elev-scroll svg { min-width: 720px; }
  .elev::after { content: ''; position: absolute; inset: 6px; border: 1px solid var(--gold); opacity: 0.3; pointer-events: none; }
  .elev svg { width: 100%; height: auto; display: block; font-family: var(--sans); }
  .ground-line { fill: none; stroke: var(--gold); stroke-width: 1.2; }
  .nile { fill: none; stroke: #3f6f93; stroke-width: 1.2; }
  .pyr { fill: var(--gold-pale); stroke: var(--gold); stroke-width: 1.1; }
  .pyr-khufu { fill: var(--cream-deep); }
  .edge { stroke: var(--gold); stroke-width: 0.7; opacity: 0.6; }
  .sphinx { fill: var(--gold); opacity: 0.7; }
  .roofs rect { fill: var(--cream-deep); stroke: var(--taupe); stroke-width: 0.8; }
  .house rect { fill: var(--paper); stroke: var(--ink); stroke-width: 1.1; }
  .house line { stroke: var(--ink); stroke-width: 0.5; opacity: 0.5; }
  .house .floor11 { fill: var(--gold); stroke: none; opacity: 0.9; }
  .house .terrace { stroke: var(--ink); stroke-width: 1.4; }
  .sight { stroke: var(--gold-text); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .sight-wedge { fill: var(--gold); opacity: 0; transition: opacity 1s var(--ease) 1.2s; }
  .go .sight-wedge { opacity: 0.1; }
  .lbl { font-family: var(--display); font-size: 16px; font-weight: 600; fill: var(--ink); }
  .lbl-floor { font-family: var(--display); font-size: 15px; font-weight: 600; fill: var(--ink); }
  .lbl-small { font-size: 10.5px; fill: var(--muted); }
  .lbl-note { font-size: 9.5px; fill: var(--muted); font-style: italic; }
  .scale line { stroke: var(--muted); stroke-width: 0.8; } .scale text { font-size: 10px; fill: var(--muted); }
  .draw { stroke-dasharray: 2400; stroke-dashoffset: 2400; }
  .go .ground-line { animation: elev-draw 2s var(--ease) forwards; }
  .go .sight { animation: elev-draw 1.4s var(--ease) 1s forwards; stroke-dasharray: 5 4; stroke-dashoffset: 0; opacity: 0; animation-name: elev-fade; }
  @keyframes elev-draw { to { stroke-dashoffset: 0; } }
  @keyframes elev-fade { to { opacity: 1; } }
  .elev figcaption { padding: 12px 16px; border-top: 1px solid var(--line); font-family: var(--display); font-size: 1.1rem; color: var(--ink); }
  html[lang='ar'] .elev figcaption { font-family: var(--sans); font-size: 1rem; direction: rtl; }
  .lbl-small, .scale text { font-size: 11.5px; }
  @media (prefers-reduced-motion: reduce) { .draw { stroke-dashoffset: 0; animation: none !important; } .sight { opacity: 1 !important; animation: none !important; } .sight-wedge { opacity: 0.1; } }
</style>
