---
/** The balcony's own wrought-iron railing, as a divider: the sun ornament between two scrolls, drawn from the photos. */
---
<div class="lattice" aria-hidden="true">
  <svg viewBox="0 0 320 28" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
    <path d="M0 14h60" opacity=".6" />
    <path d="M260 14h60" opacity=".6" />
    <g transform="translate(60 0)">
      <path d="M0 14c10-12 22-12 30 0s20 12 30 0" />
      <path d="M30 14c-4-6-10-8-16-4" opacity=".7" />
      <path d="M140 14c10-12 22-12 30 0s20 12 30 0" />
      <path d="M170 14c4-6 10-8 16-4" opacity=".7" />
      <g transform="translate(100 14)">
        <circle r="6" /><circle r="2" fill="currentColor" stroke="none" />
        <path d="M0 -9v-3M0 9v3M-9 0h-3M9 0h3M-6.4 -6.4l-2 -2M6.4 -6.4l2 -2M-6.4 6.4l-2 2M6.4 6.4l2 2" />
        <path d="M-14 0c-4-8-12-8-16 0M14 0c4-8 12-8 16 0" opacity=".7" />
      </g>
      <path d="M60 14h12M128 14h12" opacity=".6" />
    </g>
  </svg>
</div>
