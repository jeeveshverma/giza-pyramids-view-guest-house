---
/** A lotus-and-bud frieze, the Egyptian border motif, as a thin gold divider between sections. */
---
<div class="lattice" aria-hidden="true">
  <svg viewBox="0 0 260 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
    <path d="M0 18h46" opacity=".6" />
    <path d="M214 18h46" opacity=".6" />
    <g transform="translate(50 0)">
      <g id="lotus"><path d="M10 18V9M10 9c-5 0-8-4-8-8 3 0 6 2 8 6M10 9c5 0 8-4 8-8-3 0-6 2-8 6M10 9c-2-3-2-6 0-8 2 2 2 5 0 8" /><path d="M6 18h8" opacity=".6" /></g>
      <g transform="translate(30 0)"><path d="M10 18v-7M10 11c-3-1-3-5 0-7 3 2 3 6 0 7" /></g>
      <use href="#lotus" transform="translate(40 0)" />
      <g transform="translate(70 0)"><path d="M10 18v-7M10 11c-3-1-3-5 0-7 3 2 3 6 0 7" /></g>
      <use href="#lotus" transform="translate(80 0)" />
      <g transform="translate(110 0)"><path d="M10 18v-7M10 11c-3-1-3-5 0-7 3 2 3 6 0 7" /></g>
      <use href="#lotus" transform="translate(120 0)" />
      <g transform="translate(150 0)"><path d="M10 18v-7M10 11c-3-1-3-5 0-7 3 2 3 6 0 7" /></g>
    </g>
  </svg>
</div>
