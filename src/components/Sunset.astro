---
/** Date-aware ribbon: today's sunset time over the pyramids (computed on the client, the site is static) and the nightly show. */
import { useT, type Lang } from '../i18n';
import { SITE } from '../data/site';
import Landmark from './Landmark.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { t } = useT(lang);
---
<div class="sunset" data-sunset data-lat={SITE.geo.lat} data-lng={SITE.geo.lng} data-today={t('sunset.today')} data-lang={lang}>
  <div class="wrap sunset-in">
    <Landmark name="sun" size={36} />
    <p><span data-text>{t('sunset.today', { time: '…' })}</span> <span class="muted">{t('sunset.show')}</span></p>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-sunset]').forEach((el) => {
    const lat = Number(el.dataset.lat), lng = Number(el.dataset.lng);
    const now = new Date(); const y = now.getFullYear();
    const n = Math.floor((Date.UTC(y, now.getMonth(), now.getDate()) - Date.UTC(y, 0, 0)) / 864e5);
    const rad = Math.PI / 180, g = (360 / 365) * (n - 81) * rad;
    const eot = 9.87 * Math.sin(2 * g) - 7.53 * Math.cos(g) - 1.5 * Math.sin(g);
    const decl = 23.44 * rad * Math.sin(g);
    const cosH = (Math.sin(-0.833 * rad) - Math.sin(lat * rad) * Math.sin(decl)) / (Math.cos(lat * rad) * Math.cos(decl));
    const H = Math.acos(Math.max(-1, Math.min(1, cosH))) / rad;
    const lastFri = (m: number) => { const d = new Date(Date.UTC(y, m + 1, 0)); while (d.getUTCDay() !== 5) d.setUTCDate(d.getUTCDate() - 1); return +d; };
    const today = Date.UTC(y, now.getMonth(), now.getDate());
    const dst = today >= lastFri(3) && today < lastFri(9) ? 60 : 0;
    const local = (((720 - 4 * lng - eot + 4 * H) + 120 + dst) % 1440 + 1440) % 1440;
    const hh = String(Math.floor(local / 60)).padStart(2, '0'), mm = String(Math.round(local % 60)).padStart(2, '0');
    const ar = el.dataset.lang === 'ar';
    const time = ar ? `${hh}:${mm}`.replace(/\d/g, (x) => '٠١٢٣٤٥٦٧٨٩'[Number(x)]) : `${hh}:${mm}`;
    el.querySelector('[data-text]')!.textContent = el.dataset.today!.replace('{time}', time);
  });
</script>
<style>
  .sunset { background: var(--paper); border-block: 1px solid var(--line); }
  .sunset-in { display: flex; align-items: center; gap: 14px; padding-block: 10px; }
  .sunset p { margin: 0; font-family: var(--display); font-size: 1.15rem; color: var(--ink); font-weight: 500; }
  .sunset p .muted { font-family: var(--sans); font-size: 0.9rem; font-weight: 400; }
  html[lang='ar'] .sunset p { font-family: var(--sans); font-size: 1rem; font-weight: 500; }
</style>
