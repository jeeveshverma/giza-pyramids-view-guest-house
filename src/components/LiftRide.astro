---
/**
 * The ride up. Why anyone stays here, told as the lift journey: Cairo at street level is noise and
 * traffic; each few floors it thins out; at twelve the doors open on the pyramids. A brass floor
 * indicator (the half-moon dial of an old Cairo lift) and a big numeral follow the story as it
 * scrolls; the last stop is a pair of lift doors that slide apart on the terrace photo.
 * Without JavaScript or with reduced motion everything is simply shown, doors open.
 */
import { useT, digits, type Lang } from '../i18n';
import Img from './Img.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { t } = useT(lang);
const stops = [
  { f: 0, label: t('hero.liftG'), k: 'g' },
  { f: 4, label: digits(4, lang), k: 'f4' },
  { f: 8, label: digits(8, lang), k: 'f8' },
  { f: 12, label: digits(12, lang), k: 'f12' },
];
// the dial: a half circle from G (left) to 12 (right), thirteen ticks
const R = 84, CX = 100, CY = 100;
const at = (f: number, r: number) => { const a = Math.PI * (1 - f / 12); return [CX + r * Math.cos(a), CY - r * Math.sin(a)]; };
const ticks = Array.from({ length: 13 }, (_, f) => ({ f, a: at(f, R - 4), b: at(f, R - (f % 4 === 0 || f === 12 ? 18 : 11)), l: at(f, R - 30) }));
---
<section class="ride" id="ride" data-ride>
  <div class="wrap ride-in">
    <div class="ride-panel" aria-hidden="true">
      <div class="ride-plate">
        <svg class="ride-dial" viewBox="0 0 200 118" role="presentation">
          <path d={`M ${CX - R} ${CY} A ${R} ${R} 0 0 1 ${CX + R} ${CY}`} fill="none" stroke="currentColor" stroke-width="3" />
          {ticks.map((k) => <line x1={k.a[0]} y1={k.a[1]} x2={k.b[0]} y2={k.b[1]} stroke="currentColor" stroke-width={k.f % 4 === 0 || k.f === 12 ? 3 : 1.5} />)}
          {ticks.filter((k) => [0, 4, 8, 12].includes(k.f)).map((k) => <text x={k.l[0]} y={k.l[1] + 5} text-anchor="middle" class="ride-tick">{k.f === 0 ? 'G' : k.f}</text>)}
          <g class="ride-needle" data-needle><path d={`M ${CX} ${CY} L ${CX - R + 14} ${CY}`} stroke="var(--red)" stroke-width="4" stroke-linecap="round" /><path d={`M ${CX - R + 8} ${CY} l 14 -6 v 12 z`} fill="var(--red)" /></g>
          <circle cx={CX} cy={CY} r="9" fill="currentColor" /><circle cx={CX} cy={CY} r="3.5" fill="var(--gold-light)" />
        </svg>
        <p class="ride-floor"><small>{t('ride.floor')}</small><b data-floor>{t('hero.liftG')}</b></p>
      </div>
    </div>

    <div class="ride-story">
      <header class="ride-head">
        <p class="eyebrow">{t('ride.eyebrow')}</p>
        <h2>{t('ride.title')}</h2>
      </header>
      <ol class="ride-stops">
        {stops.map((s) => (
          <li class={`ride-stop ride-${s.k}`} data-stop={s.f} data-label={s.label}>
            <span class="ride-btn">{s.label}</span>
            <div>
              <h3>{t(`ride.${s.k}.t`)}</h3>
              <p>{t(`ride.${s.k}.p`)}</p>
              {s.f === 12 && (
                <div class="ride-doors" data-doors>
                  <Img id="terrace-sunset" lang={lang} ratio="16 / 10" sizes="(min-width: 960px) 620px, 100vw" widths={[480, 720, 1080, 1280]} />
                  <span class="ride-door ride-door-a"></span><span class="ride-door ride-door-b"></span>
                  <span class="ride-ding">{t('ride.ding')}</span>
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-ride]').forEach((root) => {
    const needle = root.querySelector<SVGGElement>('[data-needle]')!, floor = root.querySelector<HTMLElement>('[data-floor]')!;
    const stops = [...root.querySelectorAll<HTMLElement>('[data-stop]')];
    const set = (el: HTMLElement) => {
      const f = Number(el.dataset.stop);
      needle.style.transform = `rotate(${(f / 12) * 180}deg)`;
      floor.textContent = el.dataset.label!;
      stops.forEach((s) => s.classList.toggle('here', s === el));
    };
    root.classList.add('live');
    // the stop nearest the middle of the screen is the floor the lift is at
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) set(e.target as HTMLElement); }), { rootMargin: '-45% 0px -45% 0px' });
    stops.forEach((s) => io.observe(s));
    const doors = root.querySelector<HTMLElement>('[data-doors]');
    if (doors) new IntersectionObserver((es, o) => es.forEach((e) => { if (e.isIntersecting) { doors.classList.add('open'); o.disconnect(); } }), { threshold: 0.55 }).observe(doors);
    set(stops[0]);
  });
</script>

<style>
  .ride { background: var(--night); color: var(--cream); padding-block: clamp(56px, 9vw, 120px); border-block: 2px solid var(--ink); position: relative; }
  .ride-in { display: grid; gap: 28px; }
  .ride-head { display: grid; gap: 10px; margin-bottom: clamp(24px, 4vw, 44px); }
  .ride .eyebrow { color: var(--gold-light); }
  .ride h2 { color: var(--cream); max-width: 14em; }

  /* the brass plate with the dial */
  .ride-panel { position: sticky; top: calc(var(--header-h) + 8px); z-index: 3; }
  .ride-plate { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 10px 18px; border: 2px solid var(--ink); border-radius: 14px; color: var(--ink);
    background: linear-gradient(160deg, #f9cf62, var(--gold-light) 45%, #d99a1c); box-shadow: 5px 5px 0 var(--ink), inset 0 0 0 4px rgba(255, 255, 255, 0.18); }
  .ride-dial { width: 132px; height: auto; flex: none; direction: ltr; }
  .ride-tick { font-family: var(--poster); font-size: 15px; fill: currentColor; }
  .ride-needle { transform-origin: 100px 100px; transform-box: view-box; transition: transform 0.9s cubic-bezier(0.34, 1.3, 0.5, 1); }
  .ride-floor { margin: 0; display: grid; justify-items: end; line-height: 1; }
  .ride-floor small { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; }
  html[lang='ar'] .ride-floor small { letter-spacing: 0; font-size: 0.9rem; }
  .ride-floor b { font-family: var(--poster); font-weight: 400; font-size: 3.4rem; min-width: 1.4em; text-align: end; }
  html[lang='ar'] .ride-floor b { font-family: var(--sans); font-weight: 800; }

  .ride-stops { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(36px, 9vh, 96px); position: relative; }
  /* the shaft */
  .ride-stops::before { content: ''; position: absolute; inset-block: 22px; inset-inline-start: 22px; width: 4px; margin-inline-start: -2px; background: repeating-linear-gradient(180deg, rgba(246, 232, 201, 0.5) 0 10px, transparent 10px 20px); }
  .ride-stop { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 18px; align-items: start; position: relative; }
  .ride-btn { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; font-family: var(--poster); font-size: 1rem; color: var(--cream); background: var(--night); border: 2px solid rgba(246, 232, 201, 0.6); transition: background 0.3s, color 0.3s, box-shadow 0.3s, border-color 0.3s; }
  html[lang='ar'] .ride-btn { font-family: var(--sans); font-weight: 800; }
  .ride-stop.here .ride-btn, .ride:not(.live) .ride-btn { background: var(--gold-light); color: var(--ink); border-color: var(--ink); box-shadow: 0 0 0 5px rgba(247, 183, 51, 0.28), 0 0 28px rgba(247, 183, 51, 0.6); }
  .ride-stop h3 { color: var(--cream); font-size: clamp(1.5rem, 3.6vw, 2.1rem); margin-bottom: 8px; }
  html[lang='ar'] .ride-stop h3 { font-family: var(--poster); font-weight: 400; }
  .ride-stop p { margin: 0; max-width: 34em; color: rgba(246, 232, 201, 0.86); font-size: 1.06em; }
  .ride.live .ride-stop > div { opacity: 0.45; transition: opacity 0.4s; }
  .ride.live .ride-stop.here > div { opacity: 1; }

  /* floor twelve: the doors */
  .ride-doors { position: relative; margin-top: 20px; border: 2px solid var(--ink); border-radius: 12px; overflow: hidden; box-shadow: 8px 8px 0 var(--gold-light); max-width: 620px; }
  .ride-doors :global(.photo) { border-radius: 0; }
  .ride-door { position: absolute; inset-block: 0; width: 50.5%; background: repeating-linear-gradient(90deg, #c98f1c 0 18px, #dba42a 18px 20px, #efbf4a 20px 38px, #dba42a 38px 40px); border: 0 solid var(--ink); transition: transform 1.5s cubic-bezier(0.6, 0, 0.2, 1) 0.25s; }
  .ride-door-a { left: 0; border-right-width: 2px; } .ride-door-b { right: 0; border-left-width: 2px; }
  .ride-doors.open .ride-door-a, .ride:not(.live) .ride-door-a { transform: translateX(-101%); }
  .ride-doors.open .ride-door-b, .ride:not(.live) .ride-door-b { transform: translateX(101%); }
  .ride-ding { position: absolute; inset-inline-start: 12px; bottom: 12px; padding: 4px 12px; border: 2px solid var(--ink); border-radius: 999px; background: var(--paper); color: var(--ink); font-weight: 800; font-size: 0.85rem; box-shadow: 3px 3px 0 var(--ink); opacity: 0; transform: translateY(8px); transition: opacity 0.4s 1.5s, transform 0.4s 1.5s; }
  .ride-doors.open .ride-ding, .ride:not(.live) .ride-ding { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .ride-door, .ride-ding, .ride-needle { transition: none; } .ride.live .ride-stop > div { opacity: 1; } }

  @media (min-width: 960px) {
    .ride-in { grid-template-columns: 300px minmax(0, 1fr); gap: 72px; align-items: start; }
    .ride-panel { top: calc(var(--header-h) + 40px); }
    .ride-plate { flex-direction: column; padding: 26px 22px 20px; gap: 6px; border-radius: 20px; }
    .ride-dial { width: 100%; }
    .ride-floor { justify-items: center; } .ride-floor b { font-size: 6.5rem; text-align: center; }
    .ride-stops { gap: clamp(72px, 16vh, 150px); padding-bottom: 20px; }
    .ride-stops::before { inset-inline-start: 28px; }
    .ride-stop { grid-template-columns: 56px minmax(0, 1fr); gap: 28px; }
    .ride-btn { width: 56px; height: 56px; font-size: 1.2rem; }
  }
</style>
