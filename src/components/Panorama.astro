---
/**
 * "What you see from the balcony": a horizon diagram at true bearings. Each pyramid is drawn
 * where it stands as seen from the guest house (bearing from the coordinates in site.ts) and
 * at its apparent width and height (base and height over distance), so the picture matches the
 * window. The sun is placed at today's sunset azimuth on the client, with the time.
 */
import { useT, digits, type Lang } from '../i18n';
import { SITE, PYRAMIDS } from '../data/site';
import { bearingDeg, distanceKm, fmtKm } from '../lib/geo';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { t } = useT(lang);
// view window: 50° of horizon centred on the plateau; the empty sky above the labels is cropped (VY)
const W = 800, H = 300, VY = 56, HOR = 220, AZ0 = 245, AZ1 = 295, PPD = W / (AZ1 - AZ0), PPDv = PPD; // px per degree, same both axes
const base: Record<string, number> = { khufu: 230, khafre: 215, menkaure: 103 };
const pyr = PYRAMIDS.map((p) => {
  const km = distanceKm(SITE.geo, p.at), deg = bearingDeg(SITE.geo, p.at);
  const m = km * 1000;
  const wDeg = (base[p.id] / m) * 57.3, hDeg = ((p.height + (p.id === 'khafre' ? 10 : 0)) / m) * 57.3; // Khafre stands ~10 m higher
  const x = (deg - AZ0) * PPD, half = (wDeg / 2) * PPD, top = HOR - hDeg * PPDv;
  return { ...p, km, deg, x, half, top, kmText: fmtKm(km, lang), degText: digits(Math.round(deg), lang), mText: digits(Math.round(p.height), lang) };
}).sort((a, b) => a.deg - b.deg);
const ticks = [250, 260, 270, 280, 290];
const dirs: Record<number, { en: string; ar: string }> = { 250: { en: 'WSW', ar: 'غ ج غ' }, 260: { en: '', ar: '' }, 270: { en: 'W', ar: 'غرب' }, 280: { en: '', ar: '' }, 290: { en: 'WNW', ar: 'غ ش غ' } };
---
<figure class="pano rv" data-pano data-lat={SITE.geo.lat} data-lng={SITE.geo.lng} data-az0={AZ0} data-ppd={PPD} data-hor={HOR} dir="ltr">
  <div class="pano-scroll"><svg viewBox={`0 ${VY} ${W} ${H - VY}`} role="img" aria-label={t('view.title')}>
    <defs>
      <linearGradient id="pano-sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--night)" stop-opacity=".0" /><stop offset="1" stop-color="var(--gold)" stop-opacity=".16" /></linearGradient>
      <linearGradient id="pano-haze" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--gold)" stop-opacity=".22" /><stop offset="1" stop-color="var(--gold)" stop-opacity="0" /></linearGradient>
    </defs>
    <rect x="0" y={VY} width={W} height={HOR - VY} fill="url(#pano-sky)" />
    <rect x="0" y={HOR} width={W} height={H - HOR} fill="url(#pano-haze)" />
    <g class="pano-sun" data-sun>
      <circle r="14" />
      <path d="M0 -22v-6M0 22v6M-22 0h-6M22 0h6M-15 -15l-4 -4M15 -15l4 -4" stroke-width="1" />
    </g>
    <path class="pano-hor" d={`M0 ${HOR}H${W}`} />
    {pyr.map((p) => (
      <g class="pano-pyr" data-pyr={p.id}>
        <path class="pano-face" d={`M${p.x - p.half} ${HOR}L${p.x} ${p.top}L${p.x + p.half} ${HOR}Z`} />
        <path class="pano-edge" d={`M${p.x} ${p.top}L${p.x + p.half * 0.18} ${HOR}`} />
        {p.id === 'khafre' && <path class="pano-cap" d={`M${p.x - p.half * 0.22} ${p.top + (HOR - p.top) * 0.22}L${p.x} ${p.top}L${p.x + p.half * 0.22} ${p.top + (HOR - p.top) * 0.22}`} />}
        <line class="pano-lead" x1={p.x} y1={p.top - 6} x2={p.x} y2={p.top - 20} />
        <text class="pano-name" x={p.x} y={p.top - 40} text-anchor="middle">{p.name[lang]}</text>
        <text class="pano-fact" x={p.x} y={p.top - 26} text-anchor="middle">{t('view.height', { m: p.mText })} · {t('view.distance', { km: p.kmText })}</text>
        <text class="pano-fact pano-fact-m" x={p.x} y={p.top - 26} text-anchor="middle"><tspan x={p.x} dy="-16">{t('view.height', { m: p.mText })}</tspan><tspan x={p.x} dy="16">{t('view.distance', { km: p.kmText })}</tspan></text>
      </g>
    ))}
    <g class="pano-roofs" opacity=".55">
      <path d={`M0 ${HOR + 26}h40v-8h30v6h50v-10h40v8h60v-6h36v10h50v-8h70v6h44v-10h60v8h60v-6h50v10h60v-8h60v6h40v-6h50`} />
    </g>
    <g class="pano-scale">
      {ticks.map((d) => <g transform={`translate(${(d - AZ0) * PPD} ${H - 30})`}><path d="M0 0v-8" /><text y="16" text-anchor="middle">{digits(d, lang)}°{dirs[d][lang] ? ` ${dirs[d][lang]}` : ''}</text></g>)}
    </g>
  </svg></div>
  <p class="pano-hint" aria-hidden="true" data-hint>⟵ ⟶</p>
  <figcaption class="pano-cap-text">
    <span class="pano-badge" data-suntext>{t('sunset.today', { time: '—' })}</span>
  </figcaption>
</figure>

<script>
  // sunset time and azimuth for the guest house, today (NOAA-style approximation, ±2 min)
  document.querySelectorAll<HTMLElement>('[data-pano]').forEach((el) => {
    const lat = Number(el.dataset.lat), lng = Number(el.dataset.lng), az0 = Number(el.dataset.az0), ppd = Number(el.dataset.ppd), hor = Number(el.dataset.hor);
    const now = new Date();
    const start = Date.UTC(now.getFullYear(), 0, 0);
    const n = Math.floor((Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) - start) / 864e5);
    const rad = Math.PI / 180;
    const g = (360 / 365) * (n - 81) * rad;
    const eot = 9.87 * Math.sin(2 * g) - 7.53 * Math.cos(g) - 1.5 * Math.sin(g); // minutes
    const decl = 23.44 * rad * Math.sin((360 / 365) * (n - 81) * rad);
    const cosH = (Math.sin(-0.833 * rad) - Math.sin(lat * rad) * Math.sin(decl)) / (Math.cos(lat * rad) * Math.cos(decl));
    const H = Math.acos(Math.max(-1, Math.min(1, cosH))) / rad; // degrees
    const solarNoonUtc = 720 - 4 * lng - eot; // minutes UTC
    const sunsetUtc = solarNoonUtc + 4 * H;
    const cairo = 2 * 60; // Egypt standard time; DST +60 from late April to late October
    const dst = (() => { const y = now.getFullYear(); const lastFri = (m: number) => { const d = new Date(Date.UTC(y, m + 1, 0)); while (d.getUTCDay() !== 5) d.setUTCDate(d.getUTCDate() - 1); return d; }; const a = lastFri(3), b = lastFri(9); const t = Date.UTC(y, now.getMonth(), now.getDate()); return t >= +a && t < +b ? 60 : 0; })();
    const local = ((sunsetUtc + cairo + dst) % 1440 + 1440) % 1440;
    const hh = Math.floor(local / 60), mm = Math.round(local % 60);
    const ar = document.documentElement.lang.startsWith('ar');
    const dg = (s: string) => ar ? s.replace(/\d/g, (x) => '٠١٢٣٤٥٦٧٨٩'[Number(x)]) : s;
    const time = dg(`${String(hh).padStart(2, '0')}:${String(mm).padStart(2, '0')}`);
    const az = 360 - Math.acos(Math.sin(decl) / Math.cos(lat * rad)) / rad; // sunset azimuth
    const sun = el.querySelector<SVGGElement>('[data-sun]')!;
    const x = (az - az0) * ppd;
    sun.setAttribute('transform', `translate(${x.toFixed(1)} ${hor - 16})`);
    sun.classList.add('on');
    const sc = el.querySelector<HTMLElement>('.pano-scroll');
    // on a phone the drawing is wider than the screen: open it centred on the three pyramids, and only offer the swipe hint when there is something to swipe to
    const fit = () => {
      const over = !!sc && sc.scrollWidth > sc.clientWidth + 2;
      if (sc && over) sc.scrollLeft = sc.scrollWidth * 0.58 - sc.clientWidth / 2;
      el.classList.toggle('pano-over', over);
    };
    fit();
    addEventListener('resize', fit);
    const txt = el.querySelector<HTMLElement>('[data-suntext]')!;
    txt.textContent = txt.textContent!.replace('—', time);
  });
</script>

<style>
  .pano { margin: 0; background: var(--night); border: 1px solid rgba(217, 181, 106, 0.35); position: relative; color: var(--cream); }
  .pano::after { content: ''; position: absolute; inset: 6px; border: 1px solid var(--gold-light); opacity: 0.3; pointer-events: none; }
  .pano svg { width: 100%; height: auto; display: block; font-family: var(--sans); }
  .pano-hor { stroke: var(--gold-light); stroke-width: 1; opacity: 0.8; }
  .pano-face { fill: var(--night-2); stroke: var(--gold-light); stroke-width: 1.2; }
  .pano-edge { stroke: var(--gold-light); stroke-width: 0.8; opacity: 0.6; }
  .pano-cap { fill: none; stroke: var(--cream); stroke-width: 1; opacity: 0.8; }
  .pano-lead { stroke: var(--gold-light); stroke-width: 0.8; opacity: 0.7; stroke-dasharray: 2 3; }
  .pano-name { font-family: var(--display); font-size: 17px; fill: var(--cream); font-weight: 600; }
  html[lang='ar'] .pano-name { font-family: 'Reem Kufi', sans-serif; font-size: 16px; }
  .pano-fact { font-size: 11px; fill: var(--gold-light); letter-spacing: 0.04em; }
  html[lang='ar'] .pano-fact { font-size: 12px; letter-spacing: 0; }
  .pano-roofs path { fill: none; stroke: var(--gold-light); stroke-width: 0.9; }
  .pano-scale path { stroke: var(--gold-light); stroke-width: 1; opacity: 0.6; }
  .pano-scale text { font-size: 11px; fill: var(--gold-light); opacity: 0.8; }
  .pano-sun { opacity: 0; transition: opacity 1.2s var(--ease) 0.6s; }
  .pano-sun circle { fill: var(--gold-light); fill-opacity: 0.35; stroke: var(--gold-light); stroke-width: 1.2; }
  .pano-sun path { stroke: var(--gold-light); }
  .pano-sun.on { opacity: 1; animation: pano-glow 4s ease-in-out infinite alternate; }
  @keyframes pano-glow { from { filter: drop-shadow(0 0 0 rgba(217, 181, 106, 0)); } to { filter: drop-shadow(0 0 10px rgba(217, 181, 106, 0.7)); } }
  .pano-cap-text { padding: 12px 16px; border-top: 1px solid rgba(217, 181, 106, 0.25); font-size: 0.95rem; color: var(--gold-light); display: flex; flex-wrap: wrap; gap: 8px 20px; }
  html[dir='rtl'] .pano-cap-text { direction: rtl; }
  .pano-scroll { overflow-x: auto; scrollbar-width: none; }
  .pano-scroll::-webkit-scrollbar { display: none; }
  .pano-fact-m { display: none; }
  .pano-hint { display: none; margin: 0; padding: 6px 0 0; text-align: center; color: var(--gold-light); letter-spacing: 0.3em; font-size: 0.9rem; }
  @media (max-width: 720px) {
    /* phones: a little wider than the screen, the facts on two lines under each name so all three labels fit */
    .pano-scroll svg { width: 540px; max-width: none; }
    .pano-fact { display: none; }
    .pano-fact-m { display: block; font-size: 15px; letter-spacing: 0.02em; }
    .pano-name { font-size: 24px; transform: translateY(-18px); }
    html[lang='ar'] .pano-name { font-size: 22px; }
    .pano-scale text { font-size: 15px; }
    .pano-over .pano-hint { display: block; }
  }
  @media (prefers-reduced-motion: reduce) { .pano-sun.on { animation: none; } }
</style>
