---
/**
 * The property-page gallery, in Booking.com's layout: one large photo, four beside it, and a row
 * of thumbnails ending in "+N photos". Any tile opens a full-screen viewer over every photo in
 * `items`, with a thumbnail rail, arrows, swipe, keyboard and the caption. Images in the viewer
 * are lazy, so they only load once it opens.
 */
import { useT, digits, type Lang } from '../i18n';
import { photo } from '../data/photos';
import Img from './Img.astro';
import Icon from './Icon.astro';
interface Props { items: string[]; lang: Lang; id?: string; compact?: boolean }
const { items, lang, id = 'mosaic', compact = false } = Astro.props;
const { t } = useT(lang);
const list = items.map((i) => photo(i));
const big = list[0], side = list.slice(1, 5), strip = compact ? [] : list.slice(5, 10);
const more = list.length - (compact ? 5 : 10);
---
<div class:list={['pm', compact && 'pm-compact', list.length <= 3 && 'pm-three']} id={id} data-pm>
  <div class="pm-grid">
    <button type="button" class="pm-tile pm-big" data-open="0" aria-label={`${t('gallery.open')}: ${big.alt[lang]}`}>
      <Img id={big.id} lang={lang} sizes="(min-width: 900px) 50vw, 100vw" widths={[480, 720, 960, 1280]} priority />
    </button>
    {side.map((p, i) => (
      <button type="button" class="pm-tile pm-side" data-open={i + 1} aria-label={`${t('gallery.open')}: ${p.alt[lang]}`}>
        <Img id={p.id} lang={lang} sizes="(min-width: 900px) 25vw, 33vw" widths={[320, 480, 640]} />
        {compact && i === side.length - 1 && more > 0 && <span class="pm-more">+{digits(more, lang)}</span>}
        {i === 2 && list.length > 4 && <span class="pm-more pm-more-phone">+{digits(list.length - 4, lang)}</span>}
      </button>
    ))}
  </div>
  {strip.length > 0 && (
    <div class="pm-strip">
      {strip.map((p, i) => (
        <button type="button" class="pm-tile pm-thumb" data-open={i + 5} aria-label={`${t('gallery.open')}: ${p.alt[lang]}`}>
          <Img id={p.id} lang={lang} sizes="20vw" widths={[240, 360]} />
          {i === strip.length - 1 && more > 0 && <span class="pm-more">+{digits(more, lang)} <small>{t('bk.allPhotos', { n: digits(list.length, lang) })}</small></span>}
        </button>
      ))}
    </div>
  )}

  <div class="pm-lb" hidden data-lb role="dialog" aria-modal="true" aria-label={t('sections.gallery')}>
    <div class="pm-lb-top">
      <span class="pm-lb-count" data-count aria-live="polite"></span>
      <button type="button" class="pm-lb-x" data-close aria-label={t('gallery.close')}><Icon name="close" size={26} /></button>
    </div>
    <div class="pm-lb-stage" data-stage>
      <button type="button" class="pm-lb-arrow pm-prev" data-prev aria-label={t('gallery.prev')}><Icon name="arrowLeft" size={26} /></button>
      {list.map((p, i) => (
        <figure class="pm-lb-item" data-i={i} hidden>
          <Img id={p.id} lang={lang} sizes="100vw" widths={[720, 1080, 1440]} loading="lazy" />
          <figcaption>{(p.caption ?? p.alt)[lang]}</figcaption>
        </figure>
      ))}
      <button type="button" class="pm-lb-arrow pm-next" data-next aria-label={t('gallery.next')}><Icon name="arrowRight" size={26} /></button>
    </div>
    <div class="pm-lb-rail" data-rail>
      {list.map((p, i) => <button type="button" data-go={i} aria-label={`${digits(i + 1, lang)}`}><Img id={p.id} lang={lang} sizes="96px" widths={[160]} loading="lazy" /></button>)}
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-pm]').forEach((root) => {
    const lb = root.querySelector<HTMLElement>('[data-lb]')!;
    const items = [...lb.querySelectorAll<HTMLElement>('.pm-lb-item')];
    const rail = [...lb.querySelectorAll<HTMLButtonElement>('[data-go]')];
    const count = lb.querySelector<HTMLElement>('[data-count]')!;
    const ar = document.documentElement.lang.startsWith('ar');
    const d = (n: number) => (ar ? String(n).replace(/\d/g, (x) => '٠١٢٣٤٥٦٧٨٩'[Number(x)]) : String(n));
    let i = 0, last: HTMLElement | null = null;
    const show = (n: number) => {
      i = (n + items.length) % items.length;
      items.forEach((el, k) => (el.hidden = k !== i));
      // fetch this photo and its neighbours now, so a tap or swipe never lands on an empty stage
      [i, i + 1, i - 1].forEach((k) => items[(k + items.length) % items.length].querySelector('img')?.setAttribute('loading', 'eager'));
      rail.forEach((b, k) => b.classList.toggle('on', k === i));
      rail[i].scrollIntoView({ block: 'nearest', inline: 'center' });
      count.textContent = `${d(i + 1)} / ${d(items.length)}`;
    };
    const open = (n: number) => { last = document.activeElement as HTMLElement; lb.hidden = false; document.body.style.overflow = 'hidden'; show(n); lb.querySelector<HTMLElement>('[data-close]')!.focus(); };
    const close = () => { lb.hidden = true; document.body.style.overflow = ''; last?.focus(); };
    root.querySelectorAll<HTMLElement>('[data-open]').forEach((b) => b.addEventListener('click', () => open(Number(b.dataset.open))));
    rail.forEach((b) => b.addEventListener('click', () => show(Number(b.dataset.go))));
    lb.querySelector('[data-close]')!.addEventListener('click', close);
    lb.querySelector('[data-prev]')!.addEventListener('click', () => show(i - 1));
    lb.querySelector('[data-next]')!.addEventListener('click', () => show(i + 1));
    lb.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') show(i + (ar ? -1 : 1));
      if (e.key === 'ArrowLeft') show(i + (ar ? 1 : -1));
    });
    const stage = lb.querySelector<HTMLElement>('[data-stage]')!;
    let sx = 0;
    stage.addEventListener('touchstart', (e) => (sx = e.touches[0].clientX), { passive: true });
    stage.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - sx; if (Math.abs(dx) > 40) show(i + (dx < 0 ? 1 : -1)); }, { passive: true });
  });
</script>

<style>
  .pm-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .pm-tile { all: unset; position: relative; display: block; overflow: hidden; border-radius: 4px; cursor: zoom-in; background: var(--cream-deep); }
  .pm-tile:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }
  .pm-tile :global(.photo), .pm-tile :global(img) { width: 100%; height: 100%; border-radius: 0; }
  .pm-tile :global(img) { object-fit: cover; transition: transform 0.8s var(--ease), filter 0.3s; }
  .pm-tile:hover :global(img) { transform: scale(1.03); filter: brightness(1.05); }
  .pm-big { grid-column: 1 / -1; aspect-ratio: 4 / 3; }
  .pm-side { aspect-ratio: 1 / 1; }
  .pm-side:nth-of-type(5) { display: none; }
  .pm-strip { display: none; }
  .pm-more { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; gap: 2px; background: rgba(20, 26, 38, 0.6); color: var(--white); font-size: 1.4rem; font-weight: 700; }
  .pm-more small { font-size: 0.8rem; font-weight: 600; }
  .pm-more-phone { display: none; }
  @media (max-width: 899px) { .pm-more-phone { display: grid; } .pm-side .pm-more:not(.pm-more-phone) { display: none; } }
  @media (min-width: 900px) {
    .pm-grid { grid-template-columns: 2fr 1fr 1fr; grid-template-rows: 1fr 1fr; height: clamp(360px, 38vw, 520px); }
    .pm-big { grid-column: 1; grid-row: 1 / span 2; aspect-ratio: auto; }
    .pm-side { aspect-ratio: auto; }
    .pm-side:nth-of-type(5) { display: block; }
    .pm-strip { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; margin-top: 6px; height: clamp(90px, 9vw, 130px); }
    .pm-compact .pm-grid { height: clamp(300px, 30vw, 420px); }
    /* three photos: one large, two stacked beside it */
    .pm-three .pm-grid { grid-template-columns: 2fr 1fr; }
  }
  /* the viewer */
  .pm-lb { position: fixed; inset: 0; z-index: 100; display: grid; grid-template-rows: auto 1fr auto; background: #0c0f16; color: var(--cream); }
  .pm-lb-top { display: flex; align-items: center; justify-content: space-between; padding: 10px 16px; }
  .pm-lb-count { font-weight: 700; font-size: 0.95rem; }
  .pm-lb-x { width: 48px; height: 48px; display: grid; place-items: center; border: 0; background: none; color: var(--cream); cursor: pointer; }
  .pm-lb-stage { position: relative; display: grid; place-items: center; min-height: 0; padding: 0 8px; }
  .pm-lb-item { margin: 0; max-width: 100%; max-height: 100%; display: grid; gap: 10px; justify-items: center; }
  .pm-lb-item :global(.photo) { background: none; }
  .pm-lb-item :global(img) { max-width: min(100%, 1400px); max-height: calc(100svh - 230px); width: auto; height: auto; object-fit: contain; }
  .pm-lb-item figcaption { font-family: var(--display); font-style: italic; font-size: 1.1rem; color: rgba(244, 236, 221, 0.85); text-align: center; padding: 0 12px; }
  html[lang='ar'] .pm-lb-item figcaption { font-family: var(--sans); font-style: normal; }
  .pm-lb-arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; width: 52px; height: 52px; border-radius: 50%; border: 1px solid rgba(217, 181, 106, 0.6); background: rgba(12, 15, 22, 0.6); color: var(--cream); display: grid; place-items: center; cursor: pointer; }
  .pm-prev { inset-inline-start: 12px; } .pm-next { inset-inline-end: 12px; }
  html[dir='rtl'] .pm-lb-arrow :global(svg) { transform: scaleX(-1); }
  .pm-lb-rail { display: flex; gap: 6px; overflow-x: auto; padding: 10px 16px 16px; scrollbar-width: thin; }
  .pm-lb-rail button { flex: none; width: 84px; height: 60px; padding: 0; border: 2px solid transparent; border-radius: 3px; overflow: hidden; background: #222; cursor: pointer; opacity: 0.55; }
  .pm-lb-rail button.on { border-color: var(--gold-light); opacity: 1; }
  .pm-lb-rail :global(.photo), .pm-lb-rail :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 640px) { .pm-lb-arrow { width: 44px; height: 44px; background: rgba(12, 15, 22, 0.45); } .pm-lb-rail button { width: 64px; height: 46px; } }
  [hidden] { display: none !important; }
</style>
