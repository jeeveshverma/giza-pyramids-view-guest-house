---
import Layout from '../components/Layout.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import Lattice from '../components/Lattice.astro';
import Reviews from '../components/Reviews.astro';
import MapSection from '../components/MapSection.astro';
import Sunset from '../components/Sunset.astro';
import Panorama from '../components/Panorama.astro';
import Elevation from '../components/Elevation.astro';
import DayDial from '../components/DayDial.astro';
import Landmark from '../components/Landmark.astro';
import SearchBox from '../components/SearchBox.astro';
import Property from '../components/Property.astro';
import Availability from '../components/Availability.astro';
import LiftRide from '../components/LiftRide.astro';
import en from '../i18n/en.json';
import ar from '../i18n/ar.json';
import { PLACES } from '../data/places';
import { PHOTOS, photo } from '../data/photos';
import { fromHotel, fmtKm } from '../lib/geo';
import { getImage } from 'astro:assets';
import heroSrc from '../assets/photos/view-sunset.jpg';
import { path, useT, digits, type Lang } from '../i18n';
import { waUrl } from '../lib/wa';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { t } = useT(lang);
const wa = waUrl(t('enquire.waIntro'));
const HERO_SIZES = '100vw';
const heroImg = await getImage({ src: heroSrc, widths: [480, 720, 1080, 1440, 1600], format: 'avif', quality: 60 });
const practical: [string, string][] = ((lang === 'ar' ? ar : en) as any).practical.items;
// the sticker's edge: a 18-point price burst
const burst = Array.from({ length: 36 }, (_, i) => { const a = (i / 36) * Math.PI * 2, r = i % 2 ? 88 : 99; return (i ? 'L' : 'M') + (100 + r * Math.cos(a)).toFixed(1) + ' ' + (100 + r * Math.sin(a)).toFixed(1); }).join(' ') + 'Z';
const kmToKhufu = fmtKm(fromHotel(PLACES.find((p) => p.id === 'pyramids')!.at).km, lang);
const ticker = [t('bk.hl.view'), t('bk.hl.breakfast'), t('bk.hl.walk', { km: kmToKhufu }), t('bk.hl.desk'), t('bk.hl.pickup'), t('bk.chNoCard')];
// the gallery: the strongest ten first (big, four beside, five below), then every other photo
const lead = ['terrace-sunset', 'tv-room5', 'studio-bed', 'view-show', 'tv-sunset', 'db-room8', 'terrace-day', 'tw-beds', 'studio-kitchenette', 'tr-beds'];
const mosaic = [...lead, ...PHOTOS.map((p) => p.id).filter((id) => !lead.includes(id))];
const teaser = ['pyramids', 'sphinx', 'gem', 'saqqara'].map((id) => PLACES.find((p) => p.id === id)!).map((p) => { const g = fromHotel(p.at); return { ...p, kmText: fmtKm(g.km, lang), mins: g.mode === 'foot' ? t('giza.onFoot', { min: digits(g.min, lang) }) : t('giza.byCar', { min: digits(g.min, lang) }) }; });
---
<Layout lang={lang} page="home" title={t('meta.home.title')} desc={t('meta.home.desc')} overHero preload={{ href: heroImg.src, srcset: heroImg.srcSet.attribute, sizes: HERO_SIZES }}>
  <!-- Hero: a poster. The sunset photo, the fact in slab capitals, a price-burst sticker with the floor -->
  <section class="hero" id="top">
    <div class="hero-photo">
      <Img id="view-sunset" lang={lang} priority sizes={HERO_SIZES} widths={[480, 720, 1080, 1440, 1600]} quality={60} position="50% 42%" />
    </div>
    <div class="hero-veil" aria-hidden="true"></div>
    <div class="wrap hero-in">
      <p class="hero-tag">{t('hero.eyebrow')}</p>
      <h1 class="hero-title">{t('hero.title', { km: kmToKhufu })}</h1>
      <p class="hero-sub">{t('hero.sub')}</p>
      <div class="hero-cta">
        <a class="btn btn-lg btn-gold hero-book" href="#availability">{t('bk.checkAvail')} <Icon name="arrowRight" size={18} class="rtl-flip" /></a>
        <a class="btn btn-ghost hero-wa" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" /> {t('hero.cta')}</a>
      </div>
    </div>
    <a class="hero-badge" href="#ride" aria-label={`${t('hero.badgeTop')} ${digits(11, lang)}: ${t('hero.badgeBottom')}`}>
      <svg viewBox="0 0 200 200" aria-hidden="true"><path d={burst} /></svg>
      <span><small>{t('hero.badgeTop')}</small><b>{digits(11, lang)}</b><em>{t('hero.badgeBottom')}</em></span>
    </a>
  </section>

  <!-- the search box, straddling the bottom of the hero -->
  <div class="wrap sb-wrap"><SearchBox lang={lang} id="search" /></div>

  <!-- the listing: name, score, gallery, highlights -->
  <Property lang={lang} mosaic={mosaic} />

  <!-- the shop-front ticker: what you get, on a loop -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker-run">
      {[0, 1].map(() => <ul>{ticker.map((x) => <li>{x}</li>)}</ul>)}
    </div>
  </div>

  <Sunset lang={lang} />

  <!-- the rooms, as an availability list -->
  <Availability lang={lang} searchId="search" />

  <LiftRide lang={lang} />

  <Lattice />

  <!-- The view: the panorama at true bearings -->
  <section class="section viewsec" id="view">
    <div class="wrap">
      <div class="section-head rv">
        <span class="num floor">{digits('01', lang)}</span>
        <h2>{t('view.title')}</h2>
        <p class="lead">{t('view.text')}</p>
      </div>
      <Panorama lang={lang} />
      <div class="view-photos">
        <div class="rv"><div class="frame"><Img id="view-show" lang={lang} ratio="4 / 3" sizes="(min-width: 960px) 46vw, 100vw" /></div><p class="caption">{photo('view-show').caption![lang]}</p></div>
        <div class="rv rv-d2"><div class="frame"><Img id="tv-window" lang={lang} ratio="4 / 3" sizes="(min-width: 960px) 46vw, 100vw" /></div><p class="caption">{photo('tv-window').caption![lang]}</p></div>
      </div>
    </div>
  </section>

  <!-- Why you can see them: the profile -->
  <section class="section elevsec" id="height">
    <div class="wrap">
      <div class="section-head rv">
        <span class="num floor">{digits('02', lang)}</span>
        <h2>{t('sections.elev')}</h2>
        <p class="lead">{t('elev.text')}</p>
      </div>
      <Elevation lang={lang} />
    </div>
  </section>

  <Lattice />

  <!-- A day on the eleventh floor -->
  <section class="section daysec" id="day">
    <div class="wrap">
      <div class="section-head rv">
        <span class="num floor">{digits('03', lang)}</span>
        <h2>{t('sections.day')}</h2>
      </div>
      <div class="rv"><DayDial lang={lang} /></div>
    </div>
  </section>

  <!-- The roof terrace -->
  <section class="section reno" id="terrace">
    <div class="wrap reno-in">
      <div class="reno-photo reno-a rv"><Img id="terrace-day" lang={lang} ratio="3 / 4" sizes="(min-width: 960px) 30vw, 60vw" /><p class="caption">{photo('terrace-day').caption![lang]}</p></div>
      <div class="reno-text rv rv-d1">
        <span class="num floor">{digits('04', lang)}</span>
        <h2>{t('rooms.bathroom')}</h2>
        <p class="lead">{t('rooms.bathroomText')}</p>
        <Landmark name="sun" size={48} />
      </div>
      <div class="reno-photo reno-b rv rv-d2"><Img id="terrace-noon" lang={lang} ratio="4 / 3" sizes="(min-width: 960px) 38vw, 80vw" /><p class="caption">{photo('terrace-noon').caption![lang]}</p></div>
    </div>
  </section>

  <!-- House rules and the practical part -->
  <section class="section pract" id="rules">
    <div class="wrap pract-in">
      <div class="section-head rv"><span class="num floor">{digits('05', lang)}</span><h2>{t('sections.practical')}</h2><p class="lead">{t('practical.intro')}</p></div>
      <dl class="pract-list rv rv-d1">
        {practical.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
  </section>

  <Reviews lang={lang} />

  <!-- Giza from here -->
  <section class="section sal">
    <div class="wrap">
      <div class="section-head rv">
        <span class="num floor">{digits('06', lang)}</span>
        <h2>{t('sections.giza')}</h2>
        <p class="lead">{t('giza.intro')}</p>
      </div>
      <ul class="sal-list">
        {teaser.map((p, i) => (
          <li class={`rv rv-d${(i % 3) + 1}`}>
            <Landmark name={p.art} size={64} />
            <div><strong>{p.name[lang]}</strong><p class="small muted">{t('giza.distance', { km: p.kmText })} · {p.mins}</p></div>
          </li>
        ))}
      </ul>
      <p class="rv"><a class="btn btn-ghost" href={path(lang, 'giza')}>{t('nav.giza')} <Icon name="arrowRight" size={18} class="rtl-flip" /></a></p>
    </div>
  </section>

  <MapSection lang={lang} compact />

  <!-- the last word: back to the rooms -->
  <section class="section endcta">
    <div class="wrap endcta-in">
      <h2>{t('bk.checkAvail')}</h2>
      <p class="lead">{t('bk.endLead')}</p>
      <p><a class="btn btn-lg" href="#search">{t('bk.search')} <Icon name="arrowRight" size={18} class="rtl-flip" /></a> <a class="btn btn-ghost" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" /> {t('hero.cta')}</a></p>
    </div>
  </section>
</Layout>

<style>
  /* ---- hero: a poster over the sunset photo ---- */
  .hero { position: relative; min-height: 86svh; display: grid; align-items: end; color: var(--cream); isolation: isolate; overflow: hidden; border-bottom: 2px solid var(--ink); }
  .hero-photo { position: absolute; inset: 0; z-index: -2; }
  .hero-photo :global(.photo) { height: 100%; border-radius: 0; }
  .hero-photo :global(img) { height: 100%; width: 100%; object-fit: cover; animation: pan 30s var(--ease) both; transform-origin: 50% 40%; }
  @keyframes pan { from { transform: scale(1.1); } to { transform: scale(1); } }
  /* night indigo from the top and the reading side, a band of sunset left clear in the middle */
  .hero-veil { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(17, 26, 60, 0.72) 0%, rgba(17, 26, 60, 0.12) 30%, rgba(17, 26, 60, 0.3) 55%, rgba(17, 26, 60, 0.94) 100%), linear-gradient(90deg, rgba(17, 26, 60, 0.55) 0%, rgba(17, 26, 60, 0) 62%); }
  html[dir='rtl'] .hero-veil { background: linear-gradient(180deg, rgba(17, 26, 60, 0.72) 0%, rgba(17, 26, 60, 0.12) 30%, rgba(17, 26, 60, 0.3) 55%, rgba(17, 26, 60, 0.94) 100%), linear-gradient(270deg, rgba(17, 26, 60, 0.55) 0%, rgba(17, 26, 60, 0) 62%); }
  .hero-in { padding-top: calc(var(--header-h) + 24px); padding-bottom: 96px; display: grid; gap: 14px; justify-items: start; }
  .hero-tag { margin: 0; padding: 6px 12px; background: var(--red); color: var(--white); border: 2px solid var(--ink); border-radius: 6px; box-shadow: 3px 3px 0 var(--ink); font-size: 0.74rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; transform: rotate(-1.5deg); }
  html[lang='ar'] .hero-tag { letter-spacing: 0; font-size: 0.92rem; transform: rotate(1.5deg); }
  .hero-title { color: var(--gold-light); font-size: clamp(2.5rem, 11vw, 5rem); max-width: 10.5em; text-shadow: 3px 3px 0 var(--ink); }
  html[lang='ar'] .hero-title { font-size: clamp(2.6rem, 11.5vw, 5.2rem); max-width: 11em; }
  .hero-sub { margin: 0; max-width: 33em; font-size: 1.08em; font-weight: 500; color: var(--cream); text-shadow: 0 1px 10px rgba(17, 26, 60, 0.9); }
  .hero-cta { display: grid; gap: 10px; margin-top: 6px; }
  .hero-wa { color: var(--cream); text-decoration-color: var(--gold-light); justify-content: start; justify-self: start; padding-inline: 0; }
  /* the arrows point the way the page reads */
  :global(html[dir='rtl']) .hero-cta :global(.rtl-flip), :global(html[dir='rtl']) .sal :global(.rtl-flip), :global(html[dir='rtl']) .endcta :global(.rtl-flip) { transform: scaleX(-1); }
  @media (min-width: 560px) { .hero-cta { grid-auto-flow: column; justify-content: start; align-items: center; gap: 24px; } }
  @media (prefers-reduced-motion: reduce) { .hero-photo :global(img) { animation: none; } }
  @media (min-width: 960px) {
    .hero { min-height: 88vh; }
    .hero-in { padding-bottom: 132px; max-width: var(--container); }
    .hero-title { font-size: clamp(3.6rem, 6.4vw, 6.4rem); }
  }
  .sb-wrap { margin-top: -52px; position: relative; z-index: 4; }

  /* the sticker: a price burst with the floor on it; it takes you to the lift */
  .hero-badge { position: absolute; inset-inline-end: max(var(--gutter), 3vw); top: calc(var(--header-h) + 18px); width: 132px; aspect-ratio: 1; display: grid; place-items: center; color: var(--ink); text-decoration: none; transform: rotate(9deg); transition: transform 0.4s var(--ease); z-index: 2; filter: drop-shadow(4px 4px 0 var(--ink)); }
  html[dir='rtl'] .hero-badge { transform: rotate(-9deg); }
  .hero-badge:hover { transform: rotate(0deg) scale(1.05); }
  .hero-badge svg { position: absolute; inset: 0; width: 100%; height: 100%; fill: var(--gold-light); stroke: var(--ink); stroke-width: 3; stroke-linejoin: round; }
  .hero-badge span { position: relative; display: grid; justify-items: center; text-align: center; line-height: 1; width: 70%; }
  .hero-badge small { font-size: 0.62rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; }
  .hero-badge b { font-family: var(--poster); font-weight: 400; font-size: 3rem; margin-block: 1px 2px; }
  .hero-badge em { font-style: normal; font-size: 0.6rem; font-weight: 800; line-height: 1.15; }
  html[lang='ar'] .hero-badge small { letter-spacing: 0; font-size: 0.8rem; } html[lang='ar'] .hero-badge b { font-family: var(--sans); font-weight: 800; font-size: 2.6rem; } html[lang='ar'] .hero-badge em { font-size: 0.68rem; }
  @media (max-width: 559px) { .hero-badge { width: 104px; } .hero-badge b { font-size: 2.2rem; } .hero-badge em { font-size: 0.52rem; } html[lang='ar'] .hero-badge b { font-size: 2rem; } html[lang='ar'] .hero-badge em { font-size: 0.58rem; } }
  @media (min-width: 960px) { .hero-badge { width: 190px; top: auto; bottom: 150px; } .hero-badge b { font-size: 4.6rem; } .hero-badge small { font-size: 0.8rem; } .hero-badge em { font-size: 0.78rem; } html[lang='ar'] .hero-badge b { font-size: 4rem; } html[lang='ar'] .hero-badge em { font-size: 0.9rem; } html[lang='ar'] .hero-badge small { font-size: 1rem; } }

  /* the ticker: a shop-front sign that runs */
  .ticker { margin-top: 36px; background: var(--gold-light); color: var(--ink); border-block: 2px solid var(--ink); overflow: hidden; direction: ltr; }
  .ticker-run { display: flex; width: max-content; animation: tick 44s linear infinite; }
  .ticker ul { list-style: none; margin: 0; padding: 0; display: flex; flex: none; }
  .ticker li { padding: 11px 0; font-weight: 800; font-size: 0.95rem; white-space: nowrap; display: flex; align-items: center; }
  .ticker li::after { content: ''; width: 12px; height: 12px; margin-inline: 22px; background: var(--red); border: 2px solid var(--ink); transform: rotate(45deg); flex: none; }
  html[lang='ar'] .ticker li { direction: rtl; font-size: 1.05rem; }
  @keyframes tick { to { transform: translateX(-50%); } }
  .ticker:hover .ticker-run { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) { .ticker-run { animation: none; width: auto; flex-wrap: wrap; } .ticker ul + ul { display: none; } .ticker ul { flex-wrap: wrap; padding-inline: var(--gutter); } }

  .viewsec { background: var(--cream); }
  .view-photos { display: grid; gap: 28px; margin-top: 40px; }
  .view-photos { align-items: start; }
  .view-photos .caption { margin: 14px 0 0; }
  @media (min-width: 960px) { .view-photos { grid-template-columns: 1fr 1fr; gap: 40px; } .view-photos > :nth-child(2) { margin-top: 56px; } }

  .elevsec { background: var(--paper); }
  .daysec .section-head { margin-bottom: 20px; }
  .pract { background: var(--paper); }
  .pract-in { display: grid; gap: 24px; }
  .pract-list { margin: 0; display: grid; gap: 18px 32px; }
  .pract-list div { border-top: 2px solid var(--ink); padding-top: 12px; }
  .pract-list dt { font-family: var(--display); font-size: 1.3rem; font-weight: 600; color: var(--ink); }
  html[lang='ar'] .pract-list dt { font-family: var(--sans); font-size: 1.1rem; }
  .pract-list dd { margin: 4px 0 0; color: var(--body); }
  @media (min-width: 720px) { .pract-list { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 960px) { .pract-in { grid-template-columns: 1fr 2fr; gap: 64px; align-items: start; } .pract-in .section-head { margin: 0; } }

  .sal-list { list-style: none; margin: 0 0 24px; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .sal-list li { display: grid; gap: 8px; align-content: start; }
  .sal-list strong { font-family: var(--display); font-size: 1.35rem; line-height: 1.2; color: var(--ink); font-weight: 600; display: block; }
  html[lang='ar'] .sal-list strong { font-family: var(--sans); font-weight: 600; font-size: 1.1rem; }
  .sal-list p { margin: 2px 0 0; }
  .sal .btn-ghost { padding-inline: 0; }
  @media (min-width: 720px) { .sal-list { grid-template-columns: repeat(4, 1fr); gap: 32px; } }

  .reno { background: var(--cream); }
  .reno-in { display: grid; gap: 32px; }
  .reno-photo .caption { margin: 10px 0 0; }
  .reno-a { width: 70%; }
  .reno-b { width: 88%; margin-inline-start: auto; }
  .reno-text { display: grid; gap: 12px; max-width: 34em; }
  .reno-text :global(svg) { margin-top: 4px; }
  @media (min-width: 640px) and (max-width: 959px) {
    .reno-in { grid-template-columns: 5fr 6fr; gap: 32px 40px; align-items: center; }
    .reno-a { width: 100%; }
    .reno-b { grid-column: 1 / -1; width: 72%; }
  }
  @media (min-width: 960px) {
    .reno-in { grid-template-columns: repeat(12, 1fr); align-items: center; }
    .reno-a { grid-column: 1 / 5; width: 100%; }
    .reno-text { grid-column: 5 / 9; padding-inline: 24px; }
    .reno-b { grid-column: 9 / 13; width: 100%; margin-top: 120px; }
  }

  .endcta { background: var(--gold-light); color: var(--ink); border-top: 2px solid var(--ink); }
  .endcta-in { display: grid; gap: 14px; justify-items: start; }
  .endcta-in > * { max-width: 40rem; }
  .endcta h2 { color: var(--ink); font-size: clamp(2.2rem, 7vw, 4.4rem); }
  .endcta .lead { color: var(--ink); font-weight: 500; }
  .endcta p:last-child { display: flex; flex-wrap: wrap; gap: 12px 28px; align-items: center; margin: 8px 0 0; }
  .endcta .btn-ghost { color: var(--ink); padding-inline: 0; text-decoration-color: var(--ink); }
</style>
